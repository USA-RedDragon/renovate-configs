{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "config:best-practices",
        ":gitSignOff",
        "docker:enableMajor",
        ":pinDependencies",
        "group:recommended",
        "group:monorepos",
        "helpers:pinGitHubActionDigestsToSemver",
        "github>USA-RedDragon/renovate-configs:labels",
        "github>USA-RedDragon/renovate-configs:golang"
    ],
    "timezone": "America/Chicago",
    "minimumReleaseAge": "24 hours",
    "minimumReleaseAgeBehaviour": "timestamp-optional",
    "assignees": [
        "USA-RedDragon"
    ],
    "gitIgnoredAuthors": [
      "234130638+github-actions[bot]@users.noreply.github.com",
      "234130638+usa-reddragon-auto-commit[bot]@users.noreply.github.com",
      "usa-reddragon-auto-commit-bot[bot]@users.noreply.github.com"
    ],
    "nix": {
        "enabled": true
    },
    "lockFileMaintenance": {
        "enabled": true
    },
    "packageRules": [
        {
            "description": "Code repos: one weekly group of routine updates, merged when CI passes.",
            "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
            "groupName": "all non-major",
            "schedule": ["* 0-5 * * 6"],
            "automerge": true
        },
        {
            "description": "Major updates wait for a tick on the dependency dashboard.",
            "matchUpdateTypes": ["major"],
            "dependencyDashboardApproval": true,
            "automerge": false
        },
        {
            "matchUpdateTypes": [
                "major",
                "minor"
            ],
            "automerge": false,
            "groupName": null,
            "matchPackageNames": ["/python/"]
        },
        {
            "description": "Infra repos: semver says little about deployed apps, so every update waits for a tick.",
            "matchRepositories": ["USA-RedDragon/home-cluster-flux", "USA-RedDragon/home-cluster-sensitive", "USA-RedDragon/home-cluster-secrets", "USA-RedDragon/talos-configs", "USA-RedDragon/terraform"],
            "groupName": null,
            "schedule": ["at any time"],
            "automerge": false,
            "dependencyDashboardApproval": true
        },
        {
            "description": "Infra repos: digest updates of a fixed tag still merge on their own.",
            "matchRepositories": ["USA-RedDragon/home-cluster-flux", "USA-RedDragon/home-cluster-sensitive", "USA-RedDragon/home-cluster-secrets", "USA-RedDragon/talos-configs", "USA-RedDragon/terraform"],
            "matchUpdateTypes": ["pin", "pinDigest", "digest"],
            "dependencyDashboardApproval": false,
            "automerge": true
        },
        {
            "description": "Outside images with no usable version tags: a digest here is a real software change.",
            "matchRepositories": ["USA-RedDragon/home-cluster-flux", "USA-RedDragon/home-cluster-sensitive", "USA-RedDragon/home-cluster-secrets", "USA-RedDragon/talos-configs", "USA-RedDragon/terraform"],
            "matchPackageNames": ["/generic-device-plugin$/", "/linx-server$/", "/rtl_433_docker$/", "/jellyfin/jellyfin$/"],
            "matchUpdateTypes": ["digest"],
            "dependencyDashboardApproval": true,
            "automerge": false
        },
        {
            "description": "Wanted but quiet: routine updates once a month.",
            "matchRepositories": ["USA-RedDragon/rtz-frontend"],
            "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
            "schedule": ["* 0-5 1 * *"]
        },
        {
            "matchDatasources": ["docker"],
            "matchPackageNames": ["ubuntu"],
            "versioning": "ubuntu"
        },
        {
            "groupName": "os-packages",
            "matchDatasources": [
                "repology"
            ]
        },
        {
            "description": "aws-sdk-go-v2 has ~87k tags; paging them over GitHub GraphQL for changelogs times out (502/504) and fails every run",
            "matchSourceUrls": ["https://github.com/aws/aws-sdk-go-v2"],
            "fetchChangeLogs": "off"
        }
    ],
    "registryAliases": {
        "jacob.pub/ghcr.io": "ghcr.io",
        "jacob.pub/docker.io": "docker.io",
        "jacob.pub/lscr.io": "lscr.io",
        "jacob.pub/quay.io": "quay.io",
        "jacob.pub/registry.k8s.io": "registry.k8s.io",
        "jacob.pub/nvcr.io": "nvcr.io",
        "jacob.pub/docker.gitea.com": "docker.gitea.com",
        "jacob.pub/git.scottlabs.io": "git.scottlabs.io",
        "jacob.pub/gcr.io": "gcr.io",
        "jacob.pub/reg.kyverno.io": "reg.kyverno.io"
    },
    "prHourlyLimit": 4,
    "prConcurrentLimit": 10,
    "kubernetes": {
        "enabled": true,
        "managerFilePatterns": ["/\\.ya?ml$/"]
    },
    "customManagers": [
      {
          "customType": "regex",
          "managerFilePatterns": [
              "/.*/"
          ],
          "matchStrings": [
              "# renovate: datasource=(?<datasource>.*?)(?:\\s+extractVersion=(?<extractVersion>.+?))?(?:\\s+versioning=(?<versioning>.+?))?\\s+depName=(?<depName>.+?)?\\s(?:\\s*.*_?(?:version|VERSION)[:=]\\s*(?<currentValue>.*))?(?:\\s.*_(?:ref|REF)[:=]\\s*(?<currentDigest>.*))?"
          ],
          "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
      }
    ],
    "separateMultipleMajor": true,
    "rebaseWhen": "auto",
    "automergeType": "pr",
    "platformAutomerge": true,
    "rangeStrategy": "bump"
}
